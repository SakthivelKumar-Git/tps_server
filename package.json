  "description": "Backend API for True Power Solutions - Products, Enquiries, Services and Admin",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:status": "node cli/migrate.js status",
